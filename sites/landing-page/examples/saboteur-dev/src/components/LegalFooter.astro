---
// Legal footer — matches live saboteur.dev pattern, plus Privacy/Terms links
// (which the live site is missing — see examples/saboteur-dev/README.md).
//
// Compact single-row: 18px vertical padding, mono uppercase 10px in dim grey.
---
<footer class="border-t border-brand-rule px-6 py-[18px] flex items-center justify-between flex-wrap gap-2">
  <span class="font-mono text-[10px] tracking-[0.13em] text-brand-dim uppercase">
    © 2026 Saboteur LLC · saboteur.dev
  </span>
  <ul class="flex items-center gap-4 font-mono text-[10px] tracking-[0.13em] uppercase">
    <li><a href="/privacy" class="text-brand-dim hover:text-brand-mid transition-colors duration-150">Privacy</a></li>
    <li><a href="/terms" class="text-brand-dim hover:text-brand-mid transition-colors duration-150">Terms</a></li>
  </ul>
</footer>
