---
// Legal.astro — layout for the generated /privacy and /terms pages.
//
// Those pages are markdown written by saboteur-sites/scripts/render-policies.mjs
// and are marked GENERATED. Do not hand-edit them; change the site's
// policy.config.json or the shared body in saboteur-sites/compliance/ and
// re-render. This layout is the only part of a legal page you style.
//
// Typography comes from the shared `.prose` layer in src/styles/global.css —
// the same rules Post.astro uses for /blog and /changelog. Do not add a local
// <style> block here: a second copy of the prose scale drifts from the first,
// and legal text must stay at least as readable as the copy above it.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import LegalFooter from "../components/LegalFooter.astro";

const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  {/* No in-page section links: this page has no #mission or #products to
      scroll to. Site-level links (Blog, Changelog) still render — they are
      real routes and work from anywhere. */}
  <Nav showSections={false} />

  <main id="main" class="px-6 py-14">
    <article class="prose mx-auto max-w-[68ch]">
      <slot />
    </article>
  </main>

  <LegalFooter />
</Base>
