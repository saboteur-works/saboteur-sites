---
// /changelog — every release on ONE page, entries as anchored <h2> sections.
//
// Deliberately not one page per entry. Release notes run 30–80 words; a URL
// each would put dozens of near-identical thin pages on the domain, which is
// the scaled-content pattern in saboteur-sites/tech/seo.md §6. One page also
// means one thing to link and one thing to read top-to-bottom.
//
// Entries are authored one file per release so releases don't collide in git.
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import LegalFooter from "../components/LegalFooter.astro";

// TODO: the site's name as a person says it. Must match Base.astro's SITE_NAME.
const SITE_NAME = "TODO";

// Drafts render in dev, never in a build. Same mechanism as /blog.
const entries = (
  await getCollection(
    "changelog",
    ({ data }) => !import.meta.env.PROD || !data.draft,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// render() is async, so the bodies are resolved before the template runs.
const released = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    Content: (await render(entry)).Content,
  })),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

const iso = (d: Date) => d.toISOString().slice(0, 10);

// Dots are legal in a fragment but awkward to read and to copy out of a URL.
// The anchor is derived from the version, so a version scheme is effectively
// permanent — changing it orphans every previously-linked anchor.
const anchor = (version: string) =>
  `v${version.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`;

// Only render the toggle if something is actually behind it. A control that
// reveals nothing is worse than no control.
const hasInternal = released.some((e) => e.internal?.length);
---
<Base
  title={`Changelog — ${SITE_NAME}`}
  description="TODO: 140–160 characters, in voice. What ships here and how often."
>
  <Nav showSections={false} />

  <main id="main" class="px-6 py-14">
    <div class="mx-auto max-w-[68ch]">
      <h1
        class="font-display font-bold text-fg-primary text-[clamp(28px,6vw,40px)] tracking-[-0.03em] leading-[1.1] mb-5"
      >
        Changelog
      </h1>

      {/* TODO: one sentence. What counts as a release, what doesn't. */}
      <p class="font-sans text-[15px] leading-[1.75] text-fg-secondary mb-6">
        TODO
      </p>

      {/* The toggle. A real <input type="checkbox">, so it is keyboard
          reachable and its state is announced by a screen reader; CSS in the
          block at the bottom of this file does the revealing. No JavaScript,
          no storage, no preference to persist.

          The page opens showing what changed for a reader. That is the honest
          default: the internal list is secondary by definition, and a reader
          who wants it can say so. */}
      {/* The input, the label and .entries must stay SIBLINGS — the CSS at the
          bottom reaches from the checkbox to the entries with `~`. Wrapping
          any of them in a div silently breaks the toggle. */}
      {hasInternal && (
        <>
          <input type="checkbox" id="show-internal" class="sr-only" />
          <label
            for="show-internal"
            class="toggle inline-block mb-2 cursor-pointer border border-brand-dim px-3 py-1.5 font-mono text-[10px] tracking-[0.14em] uppercase text-fg-tertiary hover:text-fg-primary hover:border-fg-tertiary transition-colors duration-150"
          >
            <span data-when="off">Show the full picture</span>
            <span data-when="on">Show only what changed for you</span>
          </label>
        </>
      )}

      {released.length === 0 ? (
        <p class="font-mono text-[10px] tracking-[0.14em] uppercase text-fg-tertiary">
          Nothing released yet.
        </p>
      ) : (
        <div class="entries">
          {released.map((entry) => (
            <section>
              {/* The <h2> is the entry heading. Entry bodies must therefore
                  contain no headings of their own — lists and paragraphs only,
                  or the page's heading outline skips a level. */}
              <h2
                id={anchor(entry.version)}
                class="font-display font-bold text-fg-primary text-[clamp(19px,4vw,23px)] tracking-[-0.02em] leading-[1.2] mt-11 mb-2 pt-5 border-t border-brand-rule scroll-mt-[68px]"
              >
                <a
                  href={`#${anchor(entry.version)}`}
                  class="no-underline text-fg-primary hover:text-brand-red transition-colors duration-150"
                >
                  {entry.version}
                </a>
              </h2>

              <p class="font-mono text-[10px] tracking-[0.14em] uppercase text-fg-tertiary mb-4">
                <time datetime={iso(entry.date)}>{fmt(entry.date)}</time>
                {entry.summary && ` · ${entry.summary}`}
              </p>

              {/* User-visible changes. Always shown. */}
              <div class="prose">
                <entry.Content />
              </div>

              {/* Everything else, revealed by the toggle. Rendered into the
                  markup either way — this is progressive disclosure, not
                  hidden text: the reader has a control that shows it, and it
                  says the same thing to them as it does to a crawler. */}
              {(entry.internal?.length ?? 0) > 0 && (
                <div class="internal">
                  <p class="font-mono text-[10px] tracking-[0.14em] uppercase text-fg-tertiary mt-4 mb-2">
                    Internal
                  </p>
                  <ul class="prose">
                    {entry.internal.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          ))}
        </div>
      )}
    </div>
  </main>

  <LegalFooter />
</Base>

<style>
  /* The zero-JavaScript disclosure. The checkbox holds the state, these rules
     read it. Everything is a sibling of #show-internal, which is why the
     markup order above is load-bearing: input, then label, then .entries. */

  .internal {
    display: none;
  }

  #show-internal:checked ~ .entries .internal {
    display: block;
  }

  /* Label text swaps with the state, so the control always names what it will
     do next rather than what it did. */
  [data-when="on"] {
    display: none;
  }

  #show-internal:checked ~ .toggle [data-when="on"] {
    display: inline;
  }

  #show-internal:checked ~ .toggle [data-when="off"] {
    display: none;
  }

  #show-internal:checked ~ .toggle {
    color: var(--color-fg-primary);
    border-color: var(--color-fg-tertiary);
  }

  /* The checkbox is sr-only, so its own focus ring is invisible. Without this
     a keyboard user tabs onto a control with no indication they are on it. */
  #show-internal:focus-visible ~ .toggle {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }
</style>
