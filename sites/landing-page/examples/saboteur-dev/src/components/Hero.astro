---
// Hero — parent variant. Matches live saboteur.dev pattern.
//
// Sizing:
//   wordmark   clamp(48px, 12vw, 88px) condensed 700, tracking -0.04em
//   Japanese   clamp(15px, 4vw,  28px) sans 700, tracking 0.16em
//   descriptor 10px mono mid, tracking 0.18em, hairline top rule
//   body       clamp(15px, 3.5vw, 18px) sans 300 (light), leading 1.7
---
<section class="bg-brand-black border-b border-brand-rule px-6 pt-[72px] pb-[64px]">

  <div class="inline-flex flex-col gap-[5px] border-l-[4px] border-brand-red pl-5 mb-10">
    <span class="font-display font-bold text-brand-white tracking-wordmark leading-none text-[clamp(48px,12vw,88px)]">
      SABOTEUR
    </span>
    <span class="font-sans font-bold text-brand-white tracking-[0.16em] leading-none text-[clamp(15px,4vw,28px)]">
      サボタージ員
    </span>
    <span class="font-mono text-brand-mid tracking-[0.18em] text-[10px] border-t-[0.5px] border-brand-dim pt-2 mt-1">
      CREATOR-FIRST SOFTWARE — saboteur.dev
    </span>
  </div>

  <p class="font-sans font-light text-brand-mid text-[clamp(15px,3.5vw,18px)] leading-[1.7] tracking-[0.01em] max-w-3xl">
    We build tools for people who make things.
    <em class="not-italic text-brand-white">No lock-in. No committees. No feature designed by a growth team.</em>
    Just software that respects the work.
  </p>

</section>
